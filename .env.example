# URL publique et clé anon/publishable : Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé serveur uniquement : Supabase > Project Settings > API > service_role/secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Clé serveur fal.ai : tableau de bord fal > API Keys (laisser vide en simulation).
FAL_KEY=
# Identifiant de modèle OpenRouter disponible sur fal, transmis comme model à openrouter/router (ex. anthropic/claude-opus-5.5).
LLM_MODEL=
# Réservation USD maximale par requête LLM, à fixer selon le modèle et sa tarification fal/OpenRouter.
LLM_MAX_COST_USD=
# mock en simulation; live uniquement après activation et vérification de la chaîne.
PROVIDERS_MODE=mock
# Secrets aléatoires générés par l’administrateur, distincts des clés fournisseurs.
FAL_WEBHOOK_SECRET=
CRON_SECRET=
# Plafond métier et plafond d’essai fal (budget utilisateur réservé pour la bêta).
BUDGET_CAP_EUR=20
FAL_BUDGET_CAP_USD=10
USD_TO_EUR_RATE=0.92
EUR_TO_FCFA=655.957
# URL publique de production; sinon fallback Vercel puis localhost.
APP_URL=
